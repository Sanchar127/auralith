# ==========================================================
# Docker Containers
# ==========================================================

API_CONTAINER_NAME=auralith-api
CELERY_CONTAINER_NAME=auralith-celery
REDIS_CONTAINER_NAME=auralith-redis
RABBITMQ_CONTAINER_NAME=auralith-rabbitmq
OLLAMA_CONTAINER_NAME=auralith-ollama
MINIO_CONTAINER_NAME=auralith-minio
YUE_CONTAINER_NAME=auralith-yue
QDRANT_CONTAINER_NAME=auralith-qdrant
POSTGRES_CONTAINER_NAME=auralith-postgres


# ==========================================================
# Application
# ==========================================================

API_PORT=8000


# ==========================================================
# Redis
# ==========================================================

REDIS_PORT=6379


# ==========================================================
# RabbitMQ
# ==========================================================

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0


# ==========================================================
# Ollama
# ==========================================================

OLLAMA_PORT=11434

OLLAMA_BASE_URL=http://ollama:11434

OLLAMA_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text


# ==========================================================
# MinIO
# ==========================================================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-secret

MINIO_BUCKET=auralith
MINIO_SECURE=false

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# ==========================================================
# Yue
# ==========================================================

YUE_PORT=8001

# GPU configuration
# Update this when running Yue on a GPU-enabled machine.
ATTENTION_BACKEND=sdpa


# ==========================================================
# Qdrant
# ==========================================================

QDRANT_PORT=6333

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge


# ==========================================================
# PostgreSQL
# ==========================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

POSTGRES_DB=auralith
POSTGRES_USER=auralith
POSTGRES_PASSWORD=change-this-postgres-password

DATABASE_URL=postgresql+asyncpg://auralith:change-this-postgres-password@postgres:5432/auralith


# ==========================================================
# Authentication / JWT
# ==========================================================

SECRET_KEY=change-this-to-a-long-random-secret-key

JWT_ALGORITHM=HS256
JWT_ISSUER=auralith
JWT_AUDIENCE=auralith-api

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30


# ==========================================================
# Audio
# ==========================================================

MAX_AUDIO_SIZE=52428800